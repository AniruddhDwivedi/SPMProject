/* ================================
   Global palette
   Slate grey + emerald green
   ================================ */

QMainWindow,
QWidget {
    background-color: #f3f5f4;
    color: #26332d;
    font-family: "DejaVu Sans";
    font-size: 14px;
}

QLabel {
    background-color: transparent;
    color: #26332d;
}

QLabel#title {
    font-size: 28px;
    font-weight: bold;
    color: #176b4d;
}

QLabel#subtitle {
    font-size: 18px;
    color: #66736c;
}

QLabel#page_title {
    font-size: 26px;
    font-weight: bold;
    color: #176b4d;
    padding-bottom: 4px;
}

QLabel#card_value {
    font-size: 28px;
    font-weight: bold;
    color: #176b4d;
}

QWidget#login_page {
    background-color: #e5e9e6;
}

QFrame#login_card {
    background-color: #efefef;
    border: 1px solid #d0d8d2;
    border-radius: 12px;
}
/* ================================
   Cards and panels
   ================================ */

QFrame#login_card,
QFrame#dashboard_card {
    background-color: #ffffff;
    border: 1px solid #d9e1dc;
    border-radius: 10px;
}

QFrame#login_card {
    border-radius: 12px;
}

QFrame#dashboard_card {
    padding: 10px;
}

/* ================================
   Text inputs
   ================================ */

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #ffffff;
    color: #26332d;
    border: 1px solid #cbd5ce;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #198754;
    selection-color: #ffffff;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #198754;
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDateTimeEdit:disabled {
    background-color: #e9eeeb;
    color: #89958e;
}

/* Dropdowns */

QComboBox::drop-down {
    background-color: #e7eee9;
    border: none;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    width: 26px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #26332d;
    border: 1px solid #cbd5ce;
    selection-background-color: #d8eee1;
    selection-color: #145c40;
    outline: none;
}

/* ================================
   Buttons
   Green = primary action
   ================================ */

QPushButton {
    background-color: #198754;
    color: #ffffff;
    border: 1px solid #198754;
    border-radius: 6px;
    padding: 9px 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #157347;
    border-color: #157347;
}

QPushButton:pressed {
    background-color: #115c39;
    border-color: #115c39;
}

QPushButton:disabled {
    background-color: #b8c9bf;
    color: #f4f7f5;
    border-color: #b8c9bf;
}

/* Secondary / neutral actions */

QPushButton#secondary_button {
    background-color: #e5eae7;
    color: #34443a;
    border: 1px solid #cbd5ce;
}

QPushButton#secondary_button:hover {
    background-color: #d7e0da;
}

/* Red reserved for logout and negative actions */

QPushButton#logout_button,
QPushButton#negative_button {
    background-color: #c83d3d;
    color: #ffffff;
    border: 1px solid #c83d3d;
}

QPushButton#logout_button:hover,
QPushButton#negative_button:hover {
    background-color: #a92e2e;
    border-color: #a92e2e;
}

/* ================================
   Sidebar
   ================================ */

QWidget#sidebar {
    background-color: #26332d;
    min-width: 220px;
    max-width: 220px;
}

QLabel#sidebar_title {
    background-color: transparent;
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
}

QPushButton#sidebar_button {
    background-color: grey;
    color: #e1e9e4;
    border: none;
    text-align: left;
    padding: 12px;
    border-radius: 6px;
    font-weight: normal;
}

QPushButton#sidebar_button:hover {
    background-color: #3b4c42;
    color: #ffffff;
}

QPushButton#sidebar_button:checked {
    background-color: #198754;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#logout_button {
    margin-top: 6px;
}

/* ================================
   Tables
   ================================ */

QTableWidget,
QTableView {
    background-color: #ffffff;
    alternate-background-color: #f1f5f2;
    color: #26332d;
    border: 1px solid #d9e1dc;
    border-radius: 6px;
    gridline-color: #e1e7e3;
    selection-background-color: #d8eee1;
    selection-color: #145c40;
}

QTableWidget::item,
QTableView::item {
    padding: 6px;
}

QHeaderView::section {
    background-color: #e4ebe6;
    color: #34443a;
    border: none;
    border-bottom: 1px solid #cbd5ce;
    padding: 9px;
    font-weight: bold;
}

/* ================================
   Scrollbars
   ================================ */

QScrollBar:vertical {
    background-color: #e8ede9;
    width: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #b2c0b7;
    min-height: 25px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #198754;
}

QScrollBar:horizontal {
    background-color: #e8ede9;
    height: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #b2c0b7;
    min-width: 25px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #198754;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
}

/* ================================
   Tooltips and separators
   ================================ */

QToolTip {
    background-color: #26332d;
    color: #ffffff;
    border: 1px solid #53675a;
    padding: 5px;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #d9e1dc;
}
